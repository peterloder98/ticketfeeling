generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (Auth.js) ───────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  passwordHash  String?   @map("password_hash")
  image         String?
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  auditLogs   AuditLog[]
  customers   Customer[]
  carts       Cart[]
  boxOfficeInvitesSent BoxOfficeInvite[] @relation("BoxOfficeInviter")
  boxOfficeInvitesAccepted BoxOfficeInvite[] @relation("BoxOfficeInvitee")
  boxOfficeSellerGrants BoxOfficeSellerGrant[]
  boxOfficeSales Order[] @relation("BoxOfficeSeller")
  boxOfficeVoids Order[] @relation("BoxOfficeVoider")
  staffInvitesSent StaffInvite[] @relation("StaffInviter")
  staffInvitesAccepted StaffInvite[] @relation("StaffInvitee")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Organizations & RBAC ─────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings     OrganizationSettings?
  bankAccounts OrganizationBankAccount[]
  emailAccounts OrganizationEmailAccount[]
  memberships  Membership[]
  roles        Role[]
  auditLogs    AuditLog[]
  legalDocuments LegalDocument[]
  artists      Artist[]
  locations    Location[]
  venuePlans   VenuePlan[]
  tours        Tour[]
  events       Event[]
  knowledgeArticles SupportKnowledgeArticle[]
  chatSessions SupportChatSession[]
  forgottenTicketRequests ForgottenTicketRequest[]
  supportRequests SupportRequest[]
  taxRates TaxRate[]
  ticketCategoryTemplates TicketCategoryTemplate[]
  customers Customer[]
  carts Cart[]
  orders Order[]
  invoiceSequences InvoiceNumberSequence[]
  invoices Invoice[]
  payments Payment[]
  tickets Ticket[]
  webhookInbox WebhookInbox[]
  discountCodes DiscountCode[]
  giftCards GiftCard[]
  fiscalTransactions FiscalTransaction[]
  boxOfficeSessions BoxOfficeSession[]
  boxOfficeInvites BoxOfficeInvite[]
  boxOfficeSellerGrants BoxOfficeSellerGrant[]
  staffInvites StaffInvite[]
  uploadedAssets UploadedAsset[]
  stripePayouts StripePayout[]
  stripeBalanceTransactions StripeBalanceTransaction[]
  stripeWebhookEvents StripeWebhookEvent[]
  payoutDocuments PayoutDocument[]
  payoutAuditLogs PayoutAuditLog[]
  stripeOriginalUploads StripeOriginalUpload[]
  payoutDocumentSequences PayoutDocumentSequence[]
  stripePayoutReconcileRuns StripePayoutReconcileRun[]

  @@map("organizations")
}

/// Durable binary uploads (covers etc.) — used instead of local filesystem on Vercel.
model UploadedAsset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String   @default("cover")
  mimeType       String   @map("mime_type")
  byteSize       Int      @map("byte_size")
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
  @@map("uploaded_assets")
}

/// Wiederverwendbare Vorlagen — echte Kategorien hängen immer am Event.
model TicketCategoryTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  description     String?  @db.Text
  priceGrossCents Int      @map("price_gross_cents")
  capacity        Int      @default(100)
  maxPerOrder     Int      @default(10) @map("max_per_order")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
  @@map("ticket_category_templates")
}

/// Einladung für Vorverkaufs-Partner (z. B. Location verkauft vor Ort).
model BoxOfficeInvite {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  email            String
  emailNormalized  String    @map("email_normalized")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  tokenHash        String    @unique @map("token_hash")
  /// Plain token only until accepted; clear after accept in production prefer hash-only
  token            String
  status           String    @default("pending") // pending|accepted|revoked|expired
  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  invitedAt        DateTime  @default(now()) @map("invited_at")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedUserId   String?   @map("accepted_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("BoxOfficeInviter", fields: [invitedByUserId], references: [id])
  acceptedUser User?        @relation("BoxOfficeInvitee", fields: [acceptedUserId], references: [id])
  events       BoxOfficeInviteEvent[]

  @@index([organizationId, status])
  @@index([emailNormalized])
  @@map("box_office_invites")
}

model BoxOfficeInviteEvent {
  id       String @id @default(uuid()) @db.Uuid
  inviteId String @map("invite_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid

  invite BoxOfficeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  event  Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([inviteId, eventId])
  @@map("box_office_invite_events")
}

/// Einladung für Admin- oder Scanner-Zugang (Vorverkauf bleibt BoxOfficeInvite).
model StaffInvite {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  email            String
  emailNormalized  String    @map("email_normalized")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  /// organizer_admin | scanner
  roleKey          String    @map("role_key")
  tokenHash        String    @unique @map("token_hash")
  token            String
  status           String    @default("pending") // pending|accepted|revoked|expired
  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  invitedAt        DateTime  @default(now()) @map("invited_at")
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedUserId   String?   @map("accepted_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("StaffInviter", fields: [invitedByUserId], references: [id])
  acceptedUser User?        @relation("StaffInvitee", fields: [acceptedUserId], references: [id])

  @@index([organizationId, status])
  @@index([emailNormalized])
  @@map("staff_invites")
}

/// Dauerhafte Event-Freigabe für Vorverkaufs-Partner nach Annahme der Einladung.
model BoxOfficeSellerGrant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([organizationId, userId])
  @@map("box_office_seller_grants")
}

model OrganizationSettings {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @unique @map("organization_id") @db.Uuid
  legalName        String? @map("legal_name")
  legalForm        String? @map("legal_form")
  contactFirstName String? @map("contact_first_name")
  contactLastName  String? @map("contact_last_name")
  street           String?
  houseNumber      String? @map("house_number")
  postalCode       String? @map("postal_code")
  city             String?
  country          String  @default("DE")
  /// Public-facing company address (Impressum, Kontakt, AGB, …). JSON CompanyAddress.
  publicCompanyAddress  Json @default("{}") @map("public_company_address")
  /// Billing/tax address for invoices & accounting only. JSON CompanyAddress. Never show publicly.
  billingCompanyAddress Json @default("{}") @map("billing_company_address")
  phone            String?
  email            String?
  supportEmail     String? @map("support_email")
  homepage         String?
  ticketShopDomain String? @map("ticket_shop_domain")
  logoUrl          String? @map("logo_url")
  faviconUrl       String? @map("favicon_url")
  vatId            String? @map("vat_id")
  taxNumber        String? @map("tax_number")
  commercialRegister String? @map("commercial_register")
  registerCourt    String? @map("register_court")
  managingDirectors String? @map("managing_directors")
  defaultCurrency  String  @default("EUR") @map("default_currency")
  defaultTimezone  String  @default("Europe/Berlin") @map("default_timezone")
  defaultLocale    String  @default("de-DE") @map("default_locale")
  /// Legacy Vorverkaufsgebühr — superseded by platformFeeConfig (kept for migration)
  presaleFeeMode   String  @default("none") @map("presale_fee_mode")
  presaleFeeFixedCents Int @default(0) @map("presale_fee_fixed_cents")
  /// e.g. 250 = 2.50%
  presaleFeePercentBps Int @default(0) @map("presale_fee_percent_bps")
  /// Tax on fee; default 700 = 7%. Change only if advised otherwise.
  presaleFeeTaxRateBps Int @default(700) @map("presale_fee_tax_rate_bps")

  /// Central Verwaltungsgebühr config (JSON PlatformFeeConfig)
  platformFeeConfig Json @default("{}") @map("platform_fee_config")

  /// Internal Stripe cost estimates (not customer-facing)
  stripeFeeConfig Json @default("{}") @map("stripe_fee_config")
  /// after_confirmed | after_submission — default: tickets only after Stripe succeeded
  sepaTicketReleaseMode String @default("after_confirmed") @map("sepa_ticket_release_mode")
  /// Hide SEPA when event starts within this many days (global default 7)
  sepaMinDaysBeforeEvent Int @default(7) @map("sepa_min_days_before_event")
  /// UI: recommended badge, method order, etc.
  paymentUiConfig Json @default("{}") @map("payment_ui_config")

  /// PSP fee rates + activation (server-side only; never customer surcharge by default)
  paymentFeeConfig Json @default("{}") @map("payment_fee_config")

  /// Legacy single SMTP — prefer OrganizationEmailAccount; kept for migration fallback
  smtpHost         String?  @map("smtp_host")
  smtpPort         Int      @default(465) @map("smtp_port")
  smtpSecure       Boolean  @default(true) @map("smtp_secure")
  smtpUser         String?  @map("smtp_user")
  smtpPasswordEnc  String?  @map("smtp_password_enc") @db.Text
  smtpFromEmail    String?  @map("smtp_from_email")
  smtpFromName     String?  @map("smtp_from_name")

  /// Org-default tracking (overridable per event)
  trackingEnabled             Boolean @default(false) @map("tracking_enabled")
  trackingGa4MeasurementId    String? @map("tracking_ga4_measurement_id")
  trackingGtmContainerId      String? @map("tracking_gtm_container_id")
  trackingMetaPixelId         String? @map("tracking_meta_pixel_id")
  trackingGoogleAdsId         String? @map("tracking_google_ads_id")
  trackingMetaCapiTokenEnc    String? @map("tracking_meta_capi_token_enc") @db.Text

  /// TSE / KasseSichV — none | planned | fiskaly | external
  tseMode          String  @default("none") @map("tse_mode")
  tseProvider      String? @map("tse_provider")
  tseConfigEnc     String? @map("tse_config_enc") @db.Text
  tseClientId      String? @map("tse_client_id")
  tseTssId         String? @map("tse_tss_id")

  data             Json    @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Outbound SMTP account (multiple per org; one marked default for transactional mail)
model OrganizationEmailAccount {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  /// Display label, e.g. "Tickets Versand" or "Support"
  label           String
  host            String
  port            Int       @default(465)
  secure          Boolean   @default(true)
  username        String
  passwordEnc     String    @map("password_enc") @db.Text
  fromEmail       String    @map("from_email")
  fromName        String?   @map("from_name")
  isDefault       Boolean   @default(false) @map("is_default")
  lastTestedAt    DateTime? @map("last_tested_at")
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestMessage String?   @map("last_test_message") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isDefault])
  @@map("organization_email_accounts")
}

model OrganizationBankAccount {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  accountHolderEnc String?  @map("account_holder_enc")
  ibanEnc          String?  @map("iban_enc")
  bicEnc           String?  @map("bic_enc")
  bankNameEnc      String?  @map("bank_name_enc")
  purposeSchema    String?  @map("purpose_schema")
  paymentProvider  String?  @map("payment_provider")
  providerStatus   String   @default("not_connected") @map("provider_status")
  lexwareStatus    String   @default("not_connected") @map("lexware_status")
  payoutRhythm     String?  @map("payout_rhythm")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_bank_accounts")
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  status         String @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  key            String
  name           String
  isSystem       Boolean @default(false) @map("is_system")
  description    String?

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Legal ────────────────────────────────────────────────────

model LegalDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  /// When false, document is hidden from public routes (admin can still edit).
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     LegalDocumentVersion[]

  @@unique([organizationId, type])
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id              String    @id @default(uuid()) @db.Uuid
  legalDocumentId String    @map("legal_document_id") @db.Uuid
  version         String
  title           String
  content         String    @db.Text
  changelog       String?   @db.Text
  validFrom       DateTime  @map("valid_from")
  /// draft | published | archived
  status          String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  orderAcceptances OrderLegalAcceptance[]

  @@unique([legalDocumentId, version])
  @@index([legalDocumentId, status])
  @@map("legal_document_versions")
}

// ─── Artists / Locations / Tours / Events ─────────────────────

model Artist {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  legalName       String?   @map("legal_name")
  slug            String
  artistType      String    @default("solo") @map("artist_type")
  genre           String?
  origin          String?
  shortBio        String?   @map("short_bio") @db.Text
  biography       String?   @db.Text
  profileImageUrl String?   @map("profile_image_url")
  headerImageUrl  String?   @map("header_image_url")
  homepage        String?
  instagram       String?
  facebook        String?
  tiktok          String?
  youtube         String?
  spotify         String?
  seoTitle        String?   @map("seo_title")
  seoDescription  String?   @map("seo_description")
  visibility      String    @default("draft")
  publishedAt     DateTime? @map("published_at")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventLinks   EventArtist[]

  @@unique([organizationId, slug])
  @@index([organizationId, visibility])
  @@map("artists")
}

model Location {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  name               String
  slug               String
  street             String?
  houseNumber        String?  @map("house_number")
  postalCode         String?  @map("postal_code")
  city               String?
  country            String   @default("DE")
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  homepage           String?
  phone              String?
  email              String?
  description        String?  @db.Text
  maxCapacity        Int?     @map("max_capacity")
  wheelchairAccess   Boolean  @default(false) @map("wheelchair_access")
  accessibleToilet   Boolean  @default(false) @map("accessible_toilet")
  parking            Boolean  @default(false)
  cloakroom          Boolean  @default(false)
  gastronomy         Boolean  @default(false)
  houseRules         String?  @map("house_rules") @db.Text
  internalSecurity   String?  @map("internal_security") @db.Text
  travelInfo         Json     @default("{}") @map("travel_info")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        LocationRoom[]
  venuePlans   VenuePlan[]
  events       Event[]

  @@unique([organizationId, slug])
  @@map("locations")
}

/// Saalplan / Raumgestaltung (Location-basiert, Events können referenzieren).
model VenuePlan {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  name           String
  /// Hall width (X) in centimeters — exact physical size
  widthCm        Int      @map("width_cm")
  /// Hall depth (Y) in centimeters
  depthCm        Int      @map("depth_cm")
  /// Plan objects: stage, seat blocks, … (JSON array of VenuePlanObject)
  objects        Json     @default("[]")
  /// Named category slots for paint-assign in saalplan editor (key/name/color).
  /// Mapped to EventTicketCategory by name when EventSeats materialize.
  categorySlots  Json     @default("[]") @map("category_slots")
  isTemplate     Boolean  @default(false) @map("is_template")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  room         LocationRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  events       Event[]

  @@index([organizationId, locationId])
  @@map("venue_plans")
}

model LocationRoom {
  id           String   @id @default(uuid()) @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  name         String
  lengthM      Decimal? @map("length_m") @db.Decimal(8, 2)
  widthM       Decimal? @map("width_m") @db.Decimal(8, 2)
  heightM      Decimal? @map("height_m") @db.Decimal(8, 2)
  maxCapacity  Int?     @map("max_capacity")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  events     Event[]
  venuePlans VenuePlan[]

  @@index([locationId])
  @@map("location_rooms")
}

model Tour {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?   @db.Text
  coverImageUrl  String?   @map("cover_image_url")
  logoUrl        String?   @map("logo_url")
  startsOn       DateTime? @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  visibility     String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, slug])
  @@map("tours")
}

model Event {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  locationId        String?   @map("location_id") @db.Uuid
  roomId            String?   @map("room_id") @db.Uuid
  /// Optional seating / room layout for this event
  venuePlanId       String?   @map("venue_plan_id") @db.Uuid
  /// none | best_available | seat_map_and_best — relevant when venuePlanId is set
  seatingBookingMode String   @default("none") @map("seating_booking_mode")
  tourId            String?   @map("tour_id") @db.Uuid
  name              String
  subtitle          String?
  slug              String
  eventType         String    @default("concert") @map("event_type")
  shortDescription  String?   @map("short_description") @db.Text
  description       String?   @db.Text
  coverImageUrl     String?   @map("cover_image_url")
  mobileCoverUrl    String?   @map("mobile_cover_url")
  status            String    @default("draft")
  /// When status is `paused`, the previous selling status to restore on resume
  statusBeforePause String?   @map("status_before_pause")
  locale            String    @default("de-DE")
  seoTitle          String?   @map("seo_title")
  seoDescription    String?   @map("seo_description")
  eventStartsAt     DateTime? @map("event_starts_at")
  eventEndsAt       DateTime? @map("event_ends_at")
  doorsOpenAt       DateTime? @map("doors_open_at")
  doorsCloseAt      DateTime? @map("doors_close_at")
  vipDoorsOpenAt    DateTime? @map("vip_doors_open_at")
  visibleFrom       DateTime? @map("visible_from")
  visibleUntil      DateTime? @map("visible_until")
  presaleStartsAt   DateTime? @map("presale_starts_at")
  presaleEndsAt     DateTime? @map("presale_ends_at")
  /// null = inherit organization settings (legacy; unused after platform fee)
  presaleFeeMode    String?   @map("presale_fee_mode")
  presaleFeeFixedCents Int?   @map("presale_fee_fixed_cents")
  presaleFeePercentBps Int?   @map("presale_fee_percent_bps")
  /// Ticket VAT for this event; 700 = 7%
  ticketTaxRateBasisPoints Int @default(700) @map("ticket_tax_rate_basis_points")
  /// inherit | custom
  administrationFeeTaxMode String @default("inherit") @map("administration_fee_tax_mode")
  administrationFeeCustomTaxRateBasisPoints Int? @map("administration_fee_custom_tax_rate_bps")
  /// Optional override: hide SEPA N days before this event (null = use org default)
  sepaMinDaysBeforeEvent Int? @map("sepa_min_days_before_event")
  /// When creating/editing: must confirm tracking defaults or set overrides
  trackingReviewedAt  DateTime? @map("tracking_reviewed_at")
  trackingUseOrgDefaults Boolean @default(true) @map("tracking_use_org_defaults")
  trackingGa4MeasurementId String? @map("tracking_ga4_measurement_id")
  trackingGtmContainerId   String? @map("tracking_gtm_container_id")
  trackingMetaPixelId      String? @map("tracking_meta_pixel_id")
  trackingGoogleAdsId      String? @map("tracking_google_ads_id")
  /// Public: show remaining counts / scarcity badges (off by default)
  showRemainingAvailability Boolean @default(false) @map("show_remaining_availability")
  /// Block/row defaults for seat category + lock (applied on rematerialize)
  seatingLayoutConfig Json @default("{}") @map("seating_layout_config")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  room         LocationRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  venuePlan    VenuePlan?    @relation(fields: [venuePlanId], references: [id], onDelete: SetNull)
  tour         Tour?         @relation(fields: [tourId], references: [id], onDelete: SetNull)
  artists      EventArtist[]
  ticketCategories EventTicketCategory[]
  inventoryPools InventoryPool[]
  orderItems   OrderItem[]
  tickets      Ticket[]
  seats        EventSeat[]
  checkinEvents CheckinEvent[]
  discountCodes DiscountCode[]
  boxOfficeInviteEvents BoxOfficeInviteEvent[]
  boxOfficeSellerGrants BoxOfficeSellerGrant[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([eventStartsAt])
  @@index([venuePlanId])
  @@map("events")
}

/// Per-event seat inventory expanded from VenuePlan seat_blocks.
model EventSeat {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  venuePlanId    String    @map("venue_plan_id") @db.Uuid
  blockObjectId  String    @map("block_object_id")
  blockLabel     String    @map("block_label")
  rowIndex       Int       @map("row_index")
  seatIndex      Int       @map("seat_index")
  rowLabel       String    @map("row_label")
  seatNumber     String    @map("seat_number")
  /// Stable key e.g. blockId:R3:S12
  seatKey        String    @map("seat_key")
  /// available | held | sold
  status         String    @default("available")
  /// Ticket category this seat belongs to (null = unassigned)
  categoryId     String?   @map("category_id") @db.Uuid
  /// When true, seat is withheld from sale until unlocked (gradual release)
  locked         Boolean   @default(false)
  holdExpiresAt  DateTime? @map("hold_expires_at")
  cartItemId     String?   @map("cart_item_id") @db.Uuid
  ticketId       String?   @unique @map("ticket_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  event    Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category EventTicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItem CartItem?             @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  ticket   Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([eventId, seatKey])
  @@index([eventId, status])
  @@index([eventId, categoryId, status])
  @@index([eventId, locked, status])
  @@index([cartItemId])
  @@index([holdExpiresAt])
  @@map("event_seats")
}

model EventArtist {
  id                 String    @id @default(uuid()) @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  artistId           String    @map("artist_id") @db.Uuid
  role               String    @default("artist")
  isHeadliner        Boolean   @default(false) @map("is_headliner")
  sortOrder          Int       @default(0) @map("sort_order")
  shortBioOverride   String?   @map("short_bio_override") @db.Text
  announced          Boolean   @default(true)
  cancelled          Boolean   @default(false)
  visibleFrom        DateTime? @map("visible_from")
  visibleUntil       DateTime? @map("visible_until")
  internalSetTime    DateTime? @map("internal_set_time")
  publicSetTime      DateTime? @map("public_set_time")
  setDurationMinutes Int?      @map("set_duration_minutes")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([eventId, artistId])
  @@map("event_artists")
}

// ─── Support / Chatbot / Forgotten ticket ─────────────────────

