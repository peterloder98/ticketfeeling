/// Tracks Apple / Google Wallet passes issued for a ticket (void / push updates).
model TicketWalletPass {
  id            String    @id @default(uuid()) @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  /// apple | google
  provider      String
  /// Apple serialNumber (= ticketId) or Google object id (issuerId.ticketId)
  externalId    String    @map("external_id")
  /// Apple PassKit authenticationToken for web-service updates
  authToken     String?   @map("auth_token")
  /// active | voided | expired
  status        String    @default("active")
  /// Bumped on content change so Apple devices pull a fresh .pkpass
  updateTag     String?   @map("update_tag")
  googleClassId String?   @map("google_class_id")
  voidedAt      DateTime? @map("voided_at")
  lastPushedAt  DateTime? @map("last_pushed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, provider])
  @@unique([provider, externalId])
  @@index([status])
  @@map("ticket_wallet_passes")
}

