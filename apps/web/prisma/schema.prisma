  localPayoutId  String   @map("local_payout_id") @db.Uuid
  action         String
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  actorType      String   @default("system") @map("actor_type")
  actorId        String?  @map("actor_id")
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  payout       StripePayout  @relation(fields: [localPayoutId], references: [id], onDelete: Cascade)

  @@index([localPayoutId, createdAt])
  @@map("payout_audit_logs")
}

model StripeOriginalUpload {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  localPayoutId  String?  @map("local_payout_id") @db.Uuid
  /// fee_invoice|reconciliation_report|other
  kind           String   @default("other")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  checksumSha256 String   @map("checksum_sha256")
  byteSize       Int      @map("byte_size")
  data           Bytes
  periodLabel    String?  @map("period_label")
  notes          String?  @db.Text
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, localPayoutId])
  @@map("stripe_original_uploads")
}

model StripePayoutReconcileRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  /// daily|monthly|manual
  kind           String
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  status         String    @default("running")
  lookbackDays   Int       @map("lookback_days")
  payoutsSeen    Int       @default(0) @map("payouts_seen")
  payoutsUpdated Int       @default(0) @map("payouts_updated")
  errorMessage   String?   @map("error_message") @db.Text
  summaryJson    Json      @default("{}") @map("summary_json")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@map("stripe_payout_reconcile_runs")
}

