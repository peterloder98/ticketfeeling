/// Stripe automatic payout reconciliation (Finanzen → Stripe → Auszahlungen)
model StripePayout {
  id                               String    @id @default(uuid()) @db.Uuid
  organizationId                   String?   @map("organization_id") @db.Uuid
  stripePayoutId                   String    @unique @map("stripe_payout_id")
  stripeAccountId                  String?   @map("stripe_account_id")
  environment                      String    @default("live")
  amountCents                      Int       @map("amount_cents")
  currency                         String    @default("eur")
  status                           String
  method                           String?
  type                             String?
  automatic                        Boolean   @default(true)
  arrivalDate                      DateTime? @map("arrival_date")
  createdAtStripe                  DateTime? @map("created_at_stripe")
  paidAtStripe                     DateTime? @map("paid_at_stripe")
  failedAtStripe                   DateTime? @map("failed_at_stripe")
  failureCode                      String?   @map("failure_code")
  failureMessage                   String?   @map("failure_message") @db.Text
  destinationLast4                 String?   @map("destination_last4")
  /// announced|importing|in_progress|awaiting_stripe_data|partially_mapped|unreconciled|reconciled|review_required|payout_failed|unsupported_manual_payout
  transactionReconciliationStatus  String    @default("announced") @map("transaction_reconciliation_status")
  transactionReconciliationCompletedAt DateTime? @map("transaction_reconciliation_completed_at")
  importedAt                       DateTime  @default(now()) @map("imported_at")
  lastSyncedAt                     DateTime? @map("last_synced_at")
  importAttemptCount               Int       @default(0) @map("import_attempt_count")
  lastImportError                  String?   @map("last_import_error") @db.Text
  reconciliationDifferenceCents    Int?      @map("reconciliation_difference_cents")
  balanceTransactionCount          Int       @default(0) @map("balance_transaction_count")
  paginationComplete               Boolean   @default(false) @map("pagination_complete")
  /// draft|preview|finalized
  documentStatus                   String    @default("draft") @map("document_status")
  finalizedAt                      DateTime? @map("finalized_at")
  finalizedByUserId                String?   @map("finalized_by_user_id") @db.Uuid
  /// none|marked|uploaded
  lexofficeStatus                  String    @default("none") @map("lexoffice_status")
  lexofficeMarkedAt                DateTime? @map("lexoffice_marked_at")
  lexofficeReference               String?   @map("lexoffice_reference")
  adminNote                        String?   @map("admin_note") @db.Text
  summaryJson                      Json      @default("{}") @map("summary_json")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  organization         Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  balanceTransactions  StripeBalanceTransaction[]
  documents            PayoutDocument[]
  auditLogs            PayoutAuditLog[]

  @@index([organizationId, arrivalDate])
  @@index([transactionReconciliationStatus, lastSyncedAt])
  @@index([documentStatus])
  @@map("stripe_payouts")
}

