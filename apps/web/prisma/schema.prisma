  @@map("support_requests")
}

// ─── Commerce Phase 2 ─────────────────────────────────────────

model TaxRate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  rateBps        Int      @map("rate_bps") // 700 = 7.00%
  isDefaultTicket Boolean @default(false) @map("is_default_ticket")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   EventTicketCategory[]

  @@unique([organizationId, name])
  @@map("tax_rates")
}

model EventTicketCategory {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  taxRateId        String    @map("tax_rate_id") @db.Uuid
  name             String
  internalName     String?   @map("internal_name")
  description      String?   @db.Text
  color            String?
  priceGrossCents  Int       @map("price_gross_cents")
  currency         String    @default("EUR")
  capacity         Int
  safetyReserve    Int       @default(0) @map("safety_reserve")
  minPerOrder      Int       @default(1) @map("min_per_order")
  maxPerOrder      Int       @default(10) @map("max_per_order")
  maxPerCustomer   Int?      @map("max_per_customer")
  saleStartsAt     DateTime? @map("sale_starts_at")
  saleEndsAt       DateTime? @map("sale_ends_at")
  onlineBookable   Boolean   @default(true) @map("online_bookable")
  boxOfficeBookable Boolean  @default(true) @map("box_office_bookable")
  freeSeating      Boolean   @default(true) @map("free_seating")
  /// standard | standing | free_choice | vip | wheelchair
  categoryKind     String    @default("standard") @map("category_kind")
  /// Wheelchair: companion ticket free of charge
  companionFree    Boolean   @default(false) @map("companion_free")
  transferable     Boolean   @default(true)
  refundable       Boolean   @default(true)
  sortOrder        Int       @default(0) @map("sort_order")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taxRate  TaxRate        @relation(fields: [taxRateId], references: [id])
  pools    InventoryPool[]
  cartItems CartItem[]
  orderItems OrderItem[]
  tickets  Ticket[]
  seats    EventSeat[]

  @@index([eventId, status])
  @@map("event_ticket_categories")
}

model InventoryPool {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid
  channel        String @default("online") // online|box_office|internal
  capacity       Int
  soldQuantity   Int    @default(0) @map("sold_quantity")
  heldQuantity   Int    @default(0) @map("held_quantity")
  version        Int    @default(0)

  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category EventTicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  holds    InventoryHold[]

  @@unique([categoryId, channel])
  @@index([eventId])
  @@map("inventory_pools")
}

model InventoryHold {
  id         String   @id @default(uuid()) @db.Uuid
  poolId     String   @map("pool_id") @db.Uuid
  cartItemId String?  @unique @map("cart_item_id") @db.Uuid
  /// When set, hold belongs to an order awaiting async payment (e.g. SEPA)
  orderId    String?  @map("order_id") @db.Uuid
  quantity   Int
  status     String   @default("held") // held|consumed|expired|released
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  pool     InventoryPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  cartItem CartItem?     @relation(fields: [cartItemId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("inventory_holds")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  email           String
  emailNormalized String    @map("email_normalized")
  salutation      String?
  gender          String?   // female|male|diverse|undisclosed
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  birthDate       DateTime? @map("birth_date") @db.Date
  phone           String?
  locale          String    @default("de-DE")
  street          String?
  houseNumber     String?   @map("house_number")
  postalCode      String?   @map("postal_code")
  city            String?
  country         String    @default("DE")
  /// Internal staff notes (CRM)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders       Order[]
  ticketsOwned Ticket[]     @relation("TicketHolder")

  @@unique([organizationId, emailNormalized])
  @@index([userId])
  @@map("customers")
}

model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  sessionKey     String   @map("session_key")
  status         String   @default("open") // open|converted|expired
  currency       String   @default("EUR")
  discountCode   String?  @map("discount_code")
  discountCents  Int      @default(0) @map("discount_cents")
  giftCardCode   String?  @map("gift_card_code")
  giftCardAppliedCents Int @default(0) @map("gift_card_applied_cents")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        CartItem[]
  orders       Order[]

  @@unique([organizationId, sessionKey])
  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  quantity         Int
  unitPriceGrossCents Int   @map("unit_price_gross_cents")
  /// best_available | seat_map | free
  seatingMode      String?  @map("seating_mode")
  createdAt        DateTime @default(now()) @map("created_at")

  cart     Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  category EventTicketCategory @relation(fields: [categoryId], references: [id])
  hold     InventoryHold?
  seats    EventSeat[]

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  cartId             String?   @map("cart_id") @db.Uuid
  orderNumber        String    @map("order_number")
  status             String    @default("pending_payment")
  channel            String    @default("online")
  currency           String    @default("EUR")
  netCents           Int       @map("net_cents")
  taxCents           Int       @map("tax_cents")
  grossCents         Int       @map("gross_cents")
  /// Ticket subtotal gross before fees / discounts (alias of tickets before discount)
  ticketsGrossCents  Int       @default(0) @map("tickets_gross_cents")
  /// Explicit ticket subtotal before discounts (same semantics as ticketsGrossCents)
  ticketSubtotalCents Int      @default(0) @map("ticket_subtotal_cents")
  feeGrossCents      Int       @default(0) @map("fee_gross_cents")
  feeNetCents        Int       @default(0) @map("fee_net_cents")
  feeTaxCents        Int       @default(0) @map("fee_tax_cents")
  feeSnapshot        Json      @default("{}") @map("fee_snapshot")
  /// Verwaltungsgebühr snapshot (aliases fee* for clarity)
  administrationFeePercentageBasisPoints Int @default(0) @map("admin_fee_percentage_bps")
  administrationFeeGrossCents Int @default(0) @map("admin_fee_gross_cents")
  administrationFeeNetCents   Int @default(0) @map("admin_fee_net_cents")
  administrationFeeTaxCents   Int @default(0) @map("admin_fee_tax_cents")
  administrationFeeTaxAllocations Json @default("[]") @map("admin_fee_tax_allocations")
  calculationVersion String    @default("v1") @map("calculation_version")
  discountCode       String?   @map("discount_code")
  discountCents      Int       @default(0) @map("discount_cents")
  giftCardCode       String?   @map("gift_card_code")
  giftCardAppliedCents Int     @default(0) @map("gift_card_applied_cents")
  /// Customer-facing payable total (includes Verwaltungsgebühr; no payment-method surcharge)
  customerTotalCents Int       @default(0) @map("customer_total_cents")
  /// Selected online method: card | sepa_debit | apple_pay | google_pay | stripe_card | stripe_sepa
  paymentMethod      String?   @map("payment_method")
  paymentProvider    String?   @map("payment_provider")
  estimatedPaymentFeeCents Int? @map("estimated_payment_fee_cents")
  actualPaymentFeeCents    Int? @map("actual_payment_fee_cents")
  netPayoutCents           Int? @map("net_payout_cents")
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id")
  stripePaymentMethodId    String?   @map("stripe_payment_method_id")
  stripeMandateId          String?   @map("stripe_mandate_id")
  stripeChargeId           String?   @map("stripe_charge_id")
  stripeBalanceTransactionId String? @map("stripe_balance_transaction_id")
  stripeFeeEstimatedCents  Int?      @map("stripe_fee_estimated_cents")
  stripeFeeActualCents     Int?      @map("stripe_fee_actual_cents")
  stripeNetPayoutCents     Int?      @map("stripe_net_payout_cents")
  sepaMandateReference     String?   @map("sepa_mandate_reference")
  /// Masked IBAN last 4 from Stripe — never store full IBAN
  ibanLast4                String?   @map("iban_last4")
  accountHolderName        String?   @map("account_holder_name")
  /// pending | processing | paid | failed | refunded | disputed | canceled | …
  paymentStatus            String?   @map("payment_status")
  /// none | held | released | consumed
  reservationStatus        String?   @map("reservation_status")
  reservedUntil            DateTime? @map("reserved_until")
  providerTransactionId    String?   @map("provider_transaction_id")
  providerFeeCurrency      String?   @map("provider_fee_currency")
  paymentCreatedAt         DateTime? @map("payment_created_at")
  paymentProcessingAt      DateTime? @map("payment_processing_at")
  paymentCompletedAt       DateTime? @map("payment_completed_at")
  paymentSucceededAt       DateTime? @map("payment_succeeded_at")
  paymentFailedAt          DateTime? @map("payment_failed_at")
  ticketReleasedAt         DateTime? @map("ticket_released_at")
  ticketSentAt             DateTime? @map("ticket_sent_at")
  failedReasonCode         String?   @map("failed_reason_code")
  failedReasonMessage      String?   @map("failed_reason_message") @db.Text
  webhookProcessingVersion Int       @default(1) @map("webhook_processing_version")
  refundedAmountCents      Int       @default(0) @map("refunded_amount_cents")
  refundFeeCents           Int       @default(0) @map("refund_fee_cents")
  invoiceRequested         Boolean   @default(false) @map("invoice_requested")
  /// private | company | null
  invoiceRecipientType     String?   @map("invoice_recipient_type")
  invoiceCompanyName       String?   @map("invoice_company_name")
  invoiceContactName       String?   @map("invoice_contact_name")
  invoiceVatId             String?   @map("invoice_vat_id")
  invoiceOrderReference    String?   @map("invoice_order_reference")
  invoiceStreet            String?   @map("invoice_street")
  invoiceHouseNumber       String?   @map("invoice_house_number")
  invoicePostalCode        String?   @map("invoice_postal_code")
  invoiceCity              String?   @map("invoice_city")
  invoiceCountry           String?   @map("invoice_country")
  lexofficeVoucherId       String?   @map("lexoffice_voucher_id")
  lexofficeSyncStatus      String?   @map("lexoffice_sync_status")
  lexofficeSyncedAt        DateTime? @map("lexoffice_synced_at")
  billingSnapshot    Json      @map("billing_snapshot")
  sellerSnapshot     Json      @default("{}") @map("seller_snapshot")
  organizerSnapshot  Json      @default("{}") @map("organizer_snapshot")
  contractSnapshot   Json      @default("{}") @map("contract_snapshot")
  paidAt             DateTime? @map("paid_at")
  fulfillmentLockedAt DateTime? @map("fulfillment_locked_at")
