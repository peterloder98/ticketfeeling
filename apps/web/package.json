{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/ensure-lightningcss.cjs && prisma generate && node ./scripts/migrate-deploy.cjs && node ./scripts/ensure-uploaded-assets.cjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-schlagerparadies-2027.ts && tsx prisma/seed-weihnachtstraum-2026.ts",
    "db:seed:weihnachtstraum": "tsx prisma/seed-weihnachtstraum-2026.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke-full": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@prisma/client": "^6.11.1",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^7.9.0",
    "@tailwindcss/postcss": "^4",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.2",
    "google-auth-library": "^11.0.0",
    "html5-qrcode": "^2.3.8",
    "lightningcss": "1.32.0",
    "lucide-react": "^1.28.0",
    "next": "15.2.8",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "passkit-generator": "^3.5.7",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "stripe": "^18.5.0",
    "tailwindcss": "^4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
