# Copy to apps/web/.env and adjust

DATABASE_URL="postgresql://peterloder@localhost:5432/ticketfeeling?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Local seed admin (used only by prisma seed)
SEED_ADMIN_EMAIL="admin@ticketfeeling.local"
SEED_ADMIN_PASSWORD="TicketfeelingAdmin!2026"

# Encryption key for sensitive org fields (32-byte hex)
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

APP_NAME="Ticketfeeling"
APP_URL="http://localhost:3000"
# Live public URL for embeds/emails. Default in code: https://ticketfeeling-web.vercel.app
# When moving to the real domain, set:
# NEXT_PUBLIC_APP_URL="https://ticketfeeling.de"
NEXT_PUBLIC_APP_URL="https://ticketfeeling-web.vercel.app"
# Optional: restrict which parent sites may frame /embed/* (CSP frame-ancestors).
# Default / unset / "*" = all domains (needed for arbitrary organizer sites).
# EMBED_FRAME_ANCESTORS="*"
# EMBED_FRAME_ANCESTORS="https://schlagerfeeling.de https://www.schlagerfeeling.de"
# Cross-domain GA4 linker hosts (no protocol)
# TRACKING_LINKER_DOMAINS="schlagerfeeling.de www.schlagerfeeling.de ticketfeeling.de www.ticketfeeling.de"

# Payments: "dev" | "stripe"
PAYMENT_PROVIDER="dev"
DEV_PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Apple Wallet (.pkpass) ───────────────────────────────────
# Requires an Apple Developer Program membership + Pass Type ID certificate.
# Without these, "Zu Apple Wallet" buttons stay hidden for buyers.
# Setup:
#   1. Certificates, Identifiers & Profiles → Identifiers → Pass Type IDs
#   2. Create e.g. pass.com.ticketfeeling.ticket
#   3. Create a Pass Type ID certificate → export .p12 → convert to PEM:
#        openssl pkcs12 -in pass.p12 -clcerts -nokeys -out pass-cert.pem
#        openssl pkcs12 -in pass.p12 -nocerts -nodes -out pass-key.pem
#   4. Download Apple WWDR G4 intermediate (PEM)
#   5. Optional (void push): APNs Auth Key (.p8) with topic = Pass Type ID
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
# Inline PEM (use \n for newlines) OR absolute file paths:
APPLE_PASS_WWDR_PEM=""
APPLE_PASS_CERT_PEM=""
APPLE_PASS_KEY_PEM=""
# APPLE_PASS_WWDR_PATH="/absolute/path/wwdr.pem"
# APPLE_PASS_CERT_PATH="/absolute/path/pass-cert.pem"
# APPLE_PASS_KEY_PATH="/absolute/path/pass-key.pem"
APPLE_PASS_KEY_PASSPHRASE=""
# Public HTTPS base for PassKit web service (defaults to APP_URL/api/v1/wallet/apple)
# APPLE_PASS_WEB_SERVICE_URL="https://ticketfeeling.de/api/v1/wallet/apple"
# Optional APNs token auth for immediate void refresh:
# APPLE_PASS_APNS_KEY_ID=""
# APPLE_PASS_APNS_KEY_PEM=""
# APPLE_PASS_APNS_TOPIC=""   # usually same as APPLE_PASS_TYPE_ID
# APPLE_PASS_APNS_HOST="https://api.push.apple.com"
# APPLE_PASS_LOG_VERBOSE="0"

# ─── Google Wallet (Event tickets) ────────────────────────────
# Google Pay & Wallet Console → create Issuer account + service account.
# Grant the service account “Admin” on the issuer. Enable Wallet Objects API.
# Without these, "Zu Google Wallet" buttons stay hidden for buyers.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SA_EMAIL=""
# Private key PEM with \n escaped newlines, or path:
GOOGLE_WALLET_SA_PRIVATE_KEY=""
# GOOGLE_WALLET_SA_KEY_PATH="/absolute/path/sa.json-or.pem"
# Optional class id suffix prefix (per-event class still uses event id)
# GOOGLE_WALLET_CLASS_SUFFIX="ticketfeeling_event"
