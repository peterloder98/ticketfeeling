# Copy to apps/web/.env and adjust

DATABASE_URL="postgresql://peterloder@localhost:5432/ticketfeeling?schema=public"
# Production (Supabase/Neon on Vercel): use the transaction pooler URL and include:
#   ?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15&schema=public
# Runtime also appends these via lib/db/database-url.ts when missing.
# Prefer Neon/Supabase *-pooler* host (or port 6543). Direct hosts on Vercel force connection_limit=1.
# Function region must stay EU (fra1) next to the DB — see apps/web/vercel.json "regions".
# DIRECT_URL / DATABASE_URL_UNPOOLED = session/direct host (port 5432) for migrate-deploy DDL only.
# DIRECT_URL=""
# DATABASE_URL_UNPOOLED=""
# Optional overrides for Prisma pool (serverless):
# PRISMA_CONNECTION_LIMIT="10"
# PRISMA_POOL_TIMEOUT="20"
# PRISMA_CONNECT_TIMEOUT="15"
# Optional: shared rate limits across Vercel instances (Upstash Redis REST or Vercel KV).
# Without these, limits stay in-memory per isolate (still OK; not multi-instance).
# Enable on Vercel: Storage → Create Upstash Redis / KV → link to ticketfeeling-web
# (auto-injects UPSTASH_* or KV_REST_API_*). Or create at upstash.com and paste REST URL+token.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# Local Redis (optional TCP; serverless prefers REST above — REDIS_URL is not read by rate-limit.ts)
REDIS_URL="redis://127.0.0.1:6379"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Local seed admin (used only by prisma seed)
SEED_ADMIN_EMAIL="admin@ticketfeeling.local"
SEED_ADMIN_PASSWORD="TicketfeelingAdmin!2026"

# Encryption key for sensitive org fields (32-byte hex)
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

APP_NAME="Ticketfeeling"
APP_URL="http://localhost:3000"
# Live public URL for embeds/emails. Default in code: https://ticketfeeling-web.vercel.app
# When moving to the real domain, set:
# NEXT_PUBLIC_APP_URL="https://ticketfeeling.de"
NEXT_PUBLIC_APP_URL="https://ticketfeeling-web.vercel.app"
# Optional: restrict which parent sites may frame /embed/* (CSP frame-ancestors).
# Local / unset / "*" = all domains (needed for arbitrary organizer sites during dev).
# Production: set an allowlist. Add each organizer origin that embeds Ticketfeeling.
# EMBED_FRAME_ANCESTORS="*"
# EMBED_FRAME_ANCESTORS="https://ticketfeeling.de https://www.ticketfeeling.de https://ticketfeeling-web.vercel.app"
# Organizer sites (examples — append when partners go live):
# EMBED_FRAME_ANCESTORS="https://ticketfeeling.de https://www.ticketfeeling.de https://ticketfeeling-web.vercel.app https://schlagerfeeling.de https://www.schlagerfeeling.de"
# Cross-domain GA4 linker hosts (no protocol)
# TRACKING_LINKER_DOMAINS="schlagerfeeling.de www.schlagerfeeling.de ticketfeeling.de www.ticketfeeling.de"

# ─── Meta Ads (Pixel + Conversions API) ───────────────────────
# Org Pixel-ID bleibt in Stammdaten; Token hier oder encrypted in Org-Settings.
# META_PIXEL_ID=""
# META_CAPI_ACCESS_TOKEN=""
# META_ACCESS_TOKEN=""
# META_TEST_EVENT_CODE=""
# Optional client allowlist mirror for embed bridge:
# NEXT_PUBLIC_EMBED_FRAME_ANCESTORS="https://schlagerfeeling.de https://www.schlagerfeeling.de"

# ─── GA4 Measurement Protocol (complement to browser) ─────────
# GA4_API_SECRET=""
# GA4_MEASUREMENT_PROTOCOL_API_SECRET=""

# Payments: "dev" | "stripe"
PAYMENT_PROVIDER="dev"
DEV_PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Terminal Location ID (Dashboard → Terminal → Locations) for Tap to Pay / Tageskasse
STRIPE_TERMINAL_LOCATION_ID=""
# Daily/monthly payout reconciliation cron (Vercel Cron Authorization)
CRON_SECRET=""

# ─── Fiskaly TSE (scaffold — no real signatures until client is wired) ───
# Org-level TSS/Client IDs may also live in encrypted Stammdaten (tseConfigEnc).
# Even with these set, signBoxOfficeSale stays status=recorded / compliance=false
# until the certified Fiskaly HTTP client is implemented.
# FISKALY_API_KEY=""
# FISKALY_API_SECRET=""
# FISKALY_TSS_ID=""
# FISKALY_CLIENT_ID=""
# Optional API base (default Fiskaly cloud):
# FISKALY_API_URL="https://kassensichv.io/api/v1"

# ─── Lexware / Lexoffice (scaffold — stub until LEXWARE_ENABLED=1 + client) ───
# Do not set LEXWARE_ENABLED=1 until the HTTP adapter is implemented.
# LEXWARE_ENABLED="0"
# LEXWARE_API_KEY=""
# LEXWARE_ORGANIZATION_ID=""
# LEXWARE_API_URL="https://api.lexoffice.io"

# ─── Apple Wallet (.pkpass) ───────────────────────────────────
# Requires an Apple Developer Program membership + Pass Type ID certificate.
# Without these, "Zu Apple Wallet" buttons stay hidden for buyers.
# Setup:
#   1. Certificates, Identifiers & Profiles → Identifiers → Pass Type IDs
#   2. Create e.g. pass.com.ticketfeeling.ticket
#   3. Create a Pass Type ID certificate → export .p12 → convert to PEM:
#        openssl pkcs12 -in pass.p12 -clcerts -nokeys -out pass-cert.pem
#        openssl pkcs12 -in pass.p12 -nocerts -nodes -out pass-key.pem
#   4. Download Apple WWDR G4 intermediate (PEM)
#   5. Optional (void push): APNs Auth Key (.p8) with topic = Pass Type ID
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
# Inline PEM (use \n for newlines) OR absolute file paths:
APPLE_PASS_WWDR_PEM=""
APPLE_PASS_CERT_PEM=""
APPLE_PASS_KEY_PEM=""
# APPLE_PASS_WWDR_PATH="/absolute/path/wwdr.pem"
# APPLE_PASS_CERT_PATH="/absolute/path/pass-cert.pem"
# APPLE_PASS_KEY_PATH="/absolute/path/pass-key.pem"
APPLE_PASS_KEY_PASSPHRASE=""
# Public HTTPS base for PassKit web service (defaults to APP_URL/api/v1/wallet/apple)
# APPLE_PASS_WEB_SERVICE_URL="https://ticketfeeling.de/api/v1/wallet/apple"
# Optional APNs token auth for immediate void refresh:
# APPLE_PASS_APNS_KEY_ID=""
# APPLE_PASS_APNS_KEY_PEM=""
# APPLE_PASS_APNS_TOPIC=""   # usually same as APPLE_PASS_TYPE_ID
# APPLE_PASS_APNS_HOST="https://api.push.apple.com"
# APPLE_PASS_LOG_VERBOSE="0"

# ─── Google Wallet (Event tickets) ────────────────────────────
# Google Pay & Wallet Console → create Issuer account + service account.
# Grant the service account “Admin” on the issuer. Enable Wallet Objects API.
# Without these, "Zu Google Wallet" buttons stay hidden for buyers.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SA_EMAIL=""
# Private key PEM with \n escaped newlines, or path:
GOOGLE_WALLET_SA_PRIVATE_KEY=""
# GOOGLE_WALLET_SA_KEY_PATH="/absolute/path/sa.json-or.pem"
# Optional class id suffix prefix (per-event class still uses event id)
# GOOGLE_WALLET_CLASS_SUFFIX="ticketfeeling_event"
